# DACHApply production environment template
# Generate a strong key, e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=False

# Comma-separated hostnames without scheme.
ALLOWED_HOSTS=your-domain.example.com

# Public frontend/base URL. Usually same origin as Django in production.
FRONTEND_URL=https://your-domain.example.com

# Origins with scheme that may POST with CSRF cookies.
# Include your production origin, and any separate frontend origin if used.
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Security/proxy settings. For Azure/Render/Heroku-style TLS termination keep these true.
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_PROTO=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Enable HSTS only after HTTPS is confirmed working.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL. Prefer DATABASE_URL in production.
# In production this is set as a real Container App secret/env var, not from a .env file, so it is
# never subject to the local guard below. If this template is ever copied to the repo-root .env for
# local use, manage.py will refuse to start against it unless DACHAPPLY_ALLOW_PROD_DB=1 is also set
# for that command (README: "Local database safety").
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# Email for password resets.
# EMAIL_PROVIDER=auto means: use Brevo if Brevo credentials are filled;
# otherwise use LOCAL_* SMTP if filled; otherwise use legacy EMAIL_* defaults.
EMAIL_PROVIDER=auto
EMAIL_TIMEOUT=10

# Brevo SMTP. If these are filled, Brevo wins over local SMTP in auto mode.
BREVO_EMAIL_HOST=smtp-relay.brevo.com
BREVO_EMAIL_PORT=587
BREVO_EMAIL_USE_TLS=True
BREVO_EMAIL_USE_SSL=False
BREVO_EMAIL_HOST_USER=your-brevo-smtp-login
BREVO_EMAIL_HOST_PASSWORD=your-brevo-smtp-key
BREVO_DEFAULT_FROM_EMAIL=DACHApply <your-verified-sender@example.com>

# Optional local SMTP fallback, e.g. Gmail App Password.
# Paste Gmail app passwords without spaces.
LOCAL_EMAIL_HOST=smtp.gmail.com
LOCAL_EMAIL_PORT=587
LOCAL_EMAIL_USE_TLS=True
LOCAL_EMAIL_USE_SSL=False
LOCAL_EMAIL_HOST_USER=your-gmail-address@gmail.com
LOCAL_EMAIL_HOST_PASSWORD=your-gmail-app-password-without-spaces
LOCAL_DEFAULT_FROM_EMAIL=DACHApply <your-gmail-address@gmail.com>

# Optional owner-only Codex CV generation. The workspace must be private and
# contain the configured LaTeX templates; never commit those files or Codex auth.
CODEX_CV_ENABLED=False
CODEX_CV_OWNER_EMAIL=owner@example.com
CODEX_CV_WORKSPACE=/private/latex

# Abuse protection rate limits. Django REST Framework format: <number>/<second|minute|hour|day>.
RATE_LIMIT_LOGIN_IP=10/minute
RATE_LIMIT_LOGIN_ACCOUNT=5/minute
RATE_LIMIT_REGISTER_IP=5/hour
RATE_LIMIT_PASSWORD_RESET_IP=5/hour
RATE_LIMIT_PASSWORD_RESET_EMAIL=5/hour
RATE_LIMIT_PUBLIC_SUBMIT_IP=20/hour
RATE_LIMIT_IMPORT_USER=60/hour
RATE_LIMIT_CV_GENERATION_USER=3/hour

# Production error alerting (TASK-88). Unset = alerting is off and the app behaves exactly as
# before: 500s are logged to stderr, nothing is emailed. Setting ERROR_ALERT_EMAILS is the whole
# switch -- no third-party account, no DSN, no image rebuild.
#   ERROR_ALERT_EMAILS  comma-separated recipients for unhandled 500s. Empty = no alerting.
#   SERVER_EMAIL        From: address for alert mail. Defaults to DEFAULT_FROM_EMAIL, and MUST be
#                       a sender your provider has verified or the alert silently bounces.
#   ERROR_ALERT_COOLDOWN_SECONDS  per-traceback quiet window, default 300, 0 disables it. Stops a
#                       crash loop on a hot path from emailing once per request and burning the
#                       SMTP quota that password-reset mail depends on.
# 404s and throttled 429s never alert: Django logs those at WARNING, and the handler is ERROR-level.
#ERROR_ALERT_EMAILS=you@example.com
#SERVER_EMAIL=DACHApply <alerts@example.com>
#ERROR_ALERT_COOLDOWN_SECONDS=300

# TASK-226: let other devices on your home network open the app. Off by default -- with this unset
# the backend binds 127.0.0.1:8000 and only this machine can reach it. Set to 1 and the launcher
# binds 0.0.0.0:8000, builds the frontend so Django serves it at :8000 itself, and this host's own
# private IPv4 addresses are added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Never widens the
# deployed container: it is gated on DEBUG. Windows also needs an inbound firewall rule -- see
# README.md, "Reaching the app from another device on your network", for the exact command.
# Note what this exposes: the local runtime runs against the PRODUCTION database, so your real board
# becomes reachable by anything on the network, behind the Django login and nothing else.
DACHAPPLY_LAN_ACCESS=0
# Optional. Only if address detection gets it wrong (VPN, second NIC): name them yourself, comma
# separated. Private IPv4 literals only; anything else raises rather than silently widening nothing.
# DACHAPPLY_LAN_HOSTS=192.168.8.130

# TASK-232: whether a FINISHED generation or readjustment opens the output folder by itself.
# Off by default -- the popup already shows every artifact path with a copy control beside it, so this
# only ever stole focus. Set to 1 to bring the old behaviour back.
CODEX_CV_OPEN_FOLDER_ON_FINISH=0
# The master switch above it. With CODEX_CV_OPEN_OUTPUT_FOLDER=0 the server may not open a folder at
# all, including for the explicit Reveal button -- that is deliberate and is a server-side kill
# switch, not a UI preference. Leave it alone unless you mean to disable Reveal too.

# TASK-236: what may reach the CV prompt as a durable "learned preference". The field behind it is
# one line per CV readjustment, appended forever, and most of it is not a preference -- it is whole
# application briefs pasted into the readjustment box once. Filtering happens at READ time only: the
# stored field is never edited, and both settings off restores the previous prompt byte for byte.
#   CODEX_PREFERENCE_MAX_CHARS       an entry longer than this is read as a brief, not a preference.
#                                    1000 sits inside the largest gap in the measured length
#                                    distribution (961 -> 1,242), so +-200 selects the same entries.
#                                    0 = no length limit.
#   CODEX_PREFERENCE_SKIP_TRUNCATED  drop entries the 5,000-char input cap cut mid-sentence before
#                                    they were stored. Independent of the length limit: it fires
#                                    with CODEX_PREFERENCE_MAX_CHARS=0.
# Excluded entries are still stored and still listed by `manage.py review_learned_preferences`, with
# the reason. They also free budget rather than spending it -- see CODEX_LEARNED_PREFERENCES_BUDGET.
CODEX_PREFERENCE_MAX_CHARS=1000
CODEX_PREFERENCE_SKIP_TRUNCATED=1
